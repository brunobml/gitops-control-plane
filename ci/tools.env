# Tool images for lab CI (2026-10-03 Track A), pinned by multi-arch index digest. CI and `make ci-*`
# run exactly these. Bump the tag and the digest together
# (`docker buildx imagetools inspect <image>:<tag>`).
HELM_IMAGE=alpine/helm:3.19.0@sha256:aef9b56f64e866207d9591d0abd8f6d767b36aadd12edf68f8a719716d9d29c9
KUSTOMIZE_IMAGE=registry.k8s.io/kustomize/kustomize:v5.7.1@sha256:937e7832dc0b09288b1398399dadb97382a27bbc35bee8fdcac47c7de4fff14d
KUBECONFORM_IMAGE=ghcr.io/yannh/kubeconform:v0.7.0@sha256:85dbef6b4b312b99133decc9c6fc9495e9fc5f92293d4ff3b7e1b30f5611823c
SHELLCHECK_IMAGE=koalaman/shellcheck:v0.11.0@sha256:61862eba1fcf09a484ebcc6feea46f1782532571a34ed51fedf90dd25f925a8d
# Same images the lab runs (promtool from the hub Prometheus, alloy fmt from the deployed Alloy v1.20.0).
PROMETHEUS_IMAGE=quay.io/prometheus/prometheus@sha256:efd719c99d83b060d9daefdcf00360461adf279f45ef5391f8d111892118753e
ALLOY_IMAGE=docker.io/grafana/alloy@sha256:f111cce835516c5f99166342be7038496b52ced16667be5a11e19258a3e4cd30
# Built-in Kubernetes schemas for kubeconform: the lab's Kubernetes minor, from a pinned commit of
# yannh/kubernetes-json-schema (CRD schemas live in ci/schemas/, see ci/update-crd-schemas.sh).
KUBERNETES_VERSION=1.35.0
K8S_SCHEMA_LOCATION=https://raw.githubusercontent.com/yannh/kubernetes-json-schema/8df8a883b68a24a104b4a9e43c1288090ae60b3b/{{.NormalizedKubernetesVersion}}-standalone{{.StrictSuffix}}/{{.ResourceKind}}{{.KindSuffix}}.json
