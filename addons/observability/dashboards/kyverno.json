         "fixedColor": "green"
        }
       }
      ]
     }
    ]
   },
   "targets": [
    {
     "expr": "sum by (cluster, request_allowed) (rate(kyverno_admission_requests_total{cluster=~\"$cluster\", resource_namespace=~\"$namespace\"}[$__rate_interval]))",
     "legendFormat": "{{cluster}} (allowed={{request_allowed}})",
     "refId": "A"
