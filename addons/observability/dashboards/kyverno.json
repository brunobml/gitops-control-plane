{
 "uid": "lab-kyverno",
 "title": "Kyverno supply-chain & admissions",
 "tags": [
  "gitops-lab",
  "kyverno",
  "security"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "refresh": "30s",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "name": "cluster",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "definition": "label_values(up{job=\"kyverno\"}, cluster)",
    "query": {
     "query": "label_values(up{job=\"kyverno\"}, cluster)",
     "refId": "StandardVariableQuery"
    },
    "refresh": 2,
    "includeAll": true,
    "multi": true,
    "current": {
     "text": "All",
     "value": "$__all"
    }
   },
   {
    "name": "namespace",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "definition": "label_values(kyverno_image_validating_policy_results_total, resource_namespace)",
    "query": {
     "query": "label_values(kyverno_image_validating_policy_results_total, resource_namespace)",
     "refId": "StandardVariableQuery"
    },
    "refresh": 2,
    "includeAll": true,
    "multi": true,
    "current": {
     "text": "All",
     "value": "$__all"
    }
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Kyverno Controllers Running",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 5,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "yellow",
        "value": 1
       },
       {
        "color": "green",
        "value": 2
       }
      ]
     }
    }
   },
   "targets": [
    {
     "expr": "sum(up{job=\"kyverno\", cluster=~\"$cluster\"}) or vector(0)",
     "refId": "A"
    }
   ]
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Signed Images Admitted (Pass)",
   "gridPos": {
    "x": 5,
    "y": 0,
    "w": 5,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     }
    }
   },
   "targets": [
    {
     "expr": "sum(kyverno_image_validating_policy_results_total{result=\"pass\", cluster=~\"$cluster\", resource_namespace=~\"$namespace\"}) or vector(0)",
     "refId": "A"
    }
   ]
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Unsigned Images Blocked (Fail)",
   "gridPos": {
    "x": 10,
    "y": 0,
    "w": 5,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     }
    }
   },
   "targets": [
    {
     "expr": "sum(kyverno_image_validating_policy_results_total{result=\"fail\", cluster=~\"$cluster\", resource_namespace=~\"$namespace\"}) or vector(0)",
     "refId": "A"
    }
   ]
  },
  {
   "id": 4,
   "type": "stat",
   "title": "Total Admission Reviews",
   "gridPos": {
    "x": 15,
    "y": 0,
    "w": 5,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "blue",
        "value": null
       }
      ]
     }
    }
   },
   "targets": [
    {
     "expr": "sum(kyverno_admission_requests_total{cluster=~\"$cluster\", resource_namespace=~\"$namespace\"}) or vector(0)",
     "refId": "A"
    }
   ]
  },
  {
   "id": 5,
   "type": "stat",
   "title": "Avg Admission Review Latency",
   "gridPos": {
    "x": 20,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "yellow",
        "value": 5
       },
       {
        "color": "red",
        "value": 15
       }
      ]
     }
    }
   },
   "targets": [
    {
     "expr": "avg(kyverno_admission_review_duration_seconds_sum{cluster=~\"$cluster\"} / kyverno_admission_review_duration_seconds_count{cluster=~\"$cluster\"})",
     "refId": "A"
    }
   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Image Validations over Time (Pass vs Blocked)",
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "custom": {
      "drawStyle": "line",
      "lineInterpolation": "linear",
      "fillOpacity": 15
     }
    }
   },
   "targets": [
    {
     "expr": "sum by (cluster, result) (rate(kyverno_image_validating_policy_results_total{cluster=~\"$cluster\", resource_namespace=~\"$namespace\"}[$__rate_interval]))",
     "legendFormat": "{{cluster}} - {{result}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 7,
   "type": "table",
   "title": "Image Validations by Namespace & Cluster",
   "gridPos": {
    "x": 12,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "sum by (cluster, resource_namespace, result) (kyverno_image_validating_policy_results_total{cluster=~\"$cluster\", resource_namespace=~\"$namespace\"})",
     "instant": true,
     "legendFormat": "{{cluster}}/{{resource_namespace}} - {{result}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Admission Requests by Operation & Verdict",
   "gridPos": {
    "x": 0,
    "y": 12,
    "w": 24,
    "h": 7
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "custom": {
      "drawStyle": "line",
      "lineInterpolation": "linear"
     }
    }
   },
   "targets": [
    {
     "expr": "sum by (cluster, resource_request_operation, request_allowed) (rate(kyverno_admission_requests_total{cluster=~\"$cluster\", resource_namespace=~\"$namespace\"}[$__rate_interval]))",
     "legendFormat": "{{cluster}} {{resource_request_operation}} (allowed={{request_allowed}})",
     "refId": "A"
    }
   ]
  },
  {
   "id": 9,
   "type": "logs",
   "title": "Kyverno Admission Controller Logs & Policy Decisions (Loki)",
   "gridPos": {
    "x": 0,
    "y": 19,
    "w": 24,
    "h": 10
   },
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "options": {
    "showLabels": false,
    "wrapLogMessage": true,
    "enableLogDetails": true,
    "sortOrder": "Descending"
   },
   "targets": [
    {
     "expr": "{namespace=\"kyverno\", cluster=~\"$cluster\"}",
     "refId": "A"
    }
   ]
  }
 ]
}
