{
 "uid": "lab-kyverno",
 "title": "Kyverno \u2014 Security & Policy Observability",
 "description": "Enterprise Kyverno observability: security compliance, admission policy enforcement, latency performance, controller reliability, and GitOps audit logs.",
 "tags": [
  "gitops-lab",
  "kyverno",
  "security",
  "admission",
  "governance"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 3,
 "editable": true,
 "graphTooltip": 1,
 "refresh": "30s",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "annotations": {
  "list": [
   {
    "name": "Kyverno pod restarts",
    "enable": true,
    "iconColor": "orange",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "expr": "changes(kube_pod_container_status_restarts_total{namespace=\"kyverno\", cluster=~\"$cluster\"}[2m]) > 0",
    "titleFormat": "Kyverno restart",
    "textFormat": "{{pod}} / {{container}}",
    "step": "1m"
   }
  ]
 },
 "links": [
  {
   "title": "Kyverno Monitoring Guide",
   "type": "link",
   "url": "https://kyverno.io/docs/guides/monitoring/",
   "targetBlank": true,
   "icon": "doc"
  },
  {
   "title": "Kyverno Metrics Reference",
   "type": "link",
   "url": "https://kyverno.io/docs/monitoring/",
   "targetBlank": true,
   "icon": "external link"
  }
 ],
 "templating": {
  "list": [
   {
    "name": "cluster",
    "label": "Cluster",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "definition": "label_values(kyverno_admission_requests_total, cluster)",
    "query": {
     "query": "label_values(kyverno_admission_requests_total, cluster)",
     "refId": "StandardVariableQuery"
    },
    "refresh": 2,
    "sort": 1,
    "includeAll": true,
    "allValue": ".*",
    "multi": true,
    "current": {
     "text": "All",
     "value": "$__all"
    }
   },
   {
    "name": "namespace",
    "label": "Resource Namespace",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "definition": "label_values(kyverno_admission_requests_total{cluster=~\"$cluster\"}, resource_namespace)",
    "query": {
     "query": "label_values(kyverno_admission_requests_total{cluster=~\"$cluster\"}, resource_namespace)",
     "refId": "StandardVariableQuery"
    },
    "refresh": 2,
    "sort": 1,
    "includeAll": true,
    "allValue": ".*",
    "multi": true,
    "current": {
     "text": "All",
     "value": "$__all"
    }
   },
   {
    "name": "policy",
    "label": "Policy",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "definition": "label_values(kyverno_image_validating_policy_results_total{cluster=~\"$cluster\"}, policy_name)",
    "query": {
     "query": "label_values(kyverno_image_validating_policy_results_total{cluster=~\"$cluster\"}, policy_name)",
     "refId": "StandardVariableQuery"
    },
    "refresh": 2,
    "sort": 1,
    "includeAll": true,
    "allValue": ".*",
    "multi": true,
    "current": {
     "text": "All",
     "value": "$__all"
    }
   }
  ]
 },
 "panels": [
  {
   "id": 100,
   "type": "row",
   "title": "Executive Overview: Health & Compliance at a Glance",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "id": 1,
   "type": "stat",
   "title": "Policy Compliance",
   "description": "Ratio of passing policy evaluations to total evaluations across selected workloads.",
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "none"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "decimals": 1,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "yellow",
        "value": 75
       },
       {
        "color": "green",
        "value": 90
       }
      ]
     }
    }
   },
   "targets": [
    {
     "expr": "round((sum(kyverno_image_validating_policy_results_total{result=\"pass\", cluster=~\"$cluster\", resource_namespace=~\"$namespace\", policy_name=~\"$policy\"}) or sum(kyverno_policy_results{result=\"pass\", cluster=~\"$cluster\", resource_namespace=~\"$namespace\"})) / clamp_min(sum(kyverno_image_validating_policy_results_total{cluster=~\"$cluster\", resource_namespace=~\"$namespace\", policy_name=~\"$policy\"}) or sum(kyverno_policy_results{cluster=~\"$cluster\", resource_namespace=~\"$namespace\"}), 1) * 100, 0.1)",
     "refId": "A"
    }
   ]
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Policy Failures (Range)",
   "description": "Policy check failures evaluated in the selected time window (noncompliant resources/images).",
   "gridPos": {
    "x": 4,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "area"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 0,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     }
    }
   },
   "targets": [
    {
     "expr": "round(sum(increase(kyverno_image_validating_policy_results_total{result=\"fail\", cluster=~\"$cluster\", resource_namespace=~\"$namespace\", policy_name=~\"$policy\"}[$__range])) or vector(0))",
     "refId": "A"
    }
   ]
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Admission Denials (Range)",
   "description": "Total admission requests rejected and blocked by Kyverno at admission time.",
   "gridPos": {
    "x": 8,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "area"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 0,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 1
       }
      ]
     }
    }
   },
   "targets": [
    {
     "expr": "round(sum(increase(kyverno_admission_requests_total{request_allowed=\"false\", cluster=~\"$cluster\", resource_namespace=~\"$namespace\"}[$__range])) or vector(0))",
     "refId": "A"
    }
   ]
  },
  {
   "id": 4,
   "type": "stat",
   "title": "Active Policies",
   "description": "Number of distinct active policies actively evaluated across clusters.",
   "gridPos": {
    "x": 12,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "none"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 0,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "blue",
        "value": null
       }
      ]
     }
    }
   },
   "targets": [
    {
     "expr": "count(count by (policy_name) (kyverno_image_validating_policy_results_total{cluster=~\"$cluster\"} or kyverno_validating_policy_results_total{cluster=~\"$cluster\"} or kyverno_policy_results{cluster=~\"$cluster\"})) or vector(1)",
     "refId": "A"
    }
   ]
  },
  {
   "id": 5,
   "type": "stat",
   "title": "Admission Latency (p95)",
   "description": "95th percentile of Kyverno admission review duration.",
   "gridPos": {
    "x": 16,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "none"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "decimals": 2,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "yellow",
        "value": 0.5
       },
       {
        "color": "red",
        "value": 1.0
       }
      ]
     }
    }
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.95, sum by (le) (increase(kyverno_admission_review_duration_seconds_bucket{cluster=~\"$cluster\"}[$__range]))) or avg(kyverno_admission_review_duration_seconds_sum{cluster=~\"$cluster\"} / clamp_min(kyverno_admission_review_duration_seconds_count{cluster=~\"$cluster\"}, 1))",
     "refId": "A"
    }
   ]
  },
  {
   "id": 6,
   "type": "stat",
   "title": "Controller Availability",
   "description": "Controller availability percentage based on active Prometheus scrape targets.",
   "gridPos": {
    "x": 20,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "none"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "decimals": 1,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "yellow",
        "value": 80
       },
       {
        "color": "green",
        "value": 99
       }
      ]
     }
    }
   },
   "targets": [
    {
     "expr": "(sum(up{job=\"kyverno\", cluster=~\"$cluster\"}) / count(up{job=\"kyverno\", cluster=~\"$cluster\"})) * 100",
     "refId": "A"
    }
   ]
  },
  {
