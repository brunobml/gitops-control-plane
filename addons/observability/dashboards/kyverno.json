       },
       {
        "color": "red",
        "value": 1
       }
      ]
     }
    }
   },
   "targets": [
    {
     "expr": "sum(increase(kyverno_image_validating_policy_results_total{result=\"fail\", cluster=~\"$cluster\", resource_namespace=~\"$namespace\", policy_name=~\"$policy\"}[$__range])) or vector(0)",
     "refId": "A"
    }
   ]
  },
  {
   "id": 9,
   "type": "gauge",
   "title": "Image Block Ratio",
   "description": "Share of image verifications that failed. A spike indicates untrusted images or bad key rotation.",
   "gridPos": {
    "x": 12,
    "y": 6,
    "w": 6,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "min": 0,
     "max": 1,
     "decimals": 1,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "yellow",
        "value": 0.05
       },
       {
        "color": "red",
        "value": 0.2
       }
      ]
     }
    }
   },
   "targets": [
    {
     "expr": "(sum(increase(kyverno_image_validating_policy_results_total{result=\"fail\", cluster=~\"$cluster\", resource_namespace=~\"$namespace\", policy_name=~\"$policy\"}[$__range])) or vector(0)) / clamp_min(sum(increase(kyverno_image_validating_policy_results_total{cluster=~\"$cluster\", resource_namespace=~\"$namespace\", policy_name=~\"$policy\"}[$__range])), 1)",
     "refId": "A"
    }
   ]
  },
  {
   "id": 10,
   "type": "bargauge",
   "title": "Top Noncompliant Namespaces",
   "description": "Namespaces with the most blocked or noncompliant image deployments.",
   "gridPos": {
    "x": 18,
    "y": 6,
    "w": 6,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "options": {
    "orientation": "horizontal",
    "displayMode": "gradient",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 0,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "orange",
        "value": null
       },
       {
        "color": "red",
        "value": 10
       }
      ]
     }
    }
   },
   "targets": [
    {
     "expr": "topk(10, sum by (cluster, resource_namespace) (increase(kyverno_image_validating_policy_results_total{result=\"fail\", cluster=~\"$cluster\", resource_namespace=~\"$namespace\"}[$__range])) > 0)",
     "legendFormat": "{{cluster}}/{{resource_namespace}}",
     "instant": true,
     "refId": "A"
    }
   ]
  },
  {
   "id": 11,
   "type": "timeseries",
   "title": "Image Validations Over Time (Pass vs Blocked)",
   "gridPos": {
    "x": 0,
    "y": 10,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ops",
     "custom": {
      "drawStyle": "line",
      "fillOpacity": 15,
      "lineInterpolation": "smooth"
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byRegexp",
       "options": ".*fail.*"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "red"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byRegexp",
       "options": ".*pass.*"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "green"
        }
       }
      ]
     }
    ]
   },
   "targets": [
    {
     "expr": "sum by (cluster, result) (rate(kyverno_image_validating_policy_results_total{cluster=~\"$cluster\", resource_namespace=~\"$namespace\", policy_name=~\"$policy\"}[$__rate_interval]))",
     "legendFormat": "{{cluster}} - {{result}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 12,
   "type": "table",
   "title": "Compliance Breakdown by Cluster, Policy & Namespace",
   "gridPos": {
    "x": 12,
    "y": 10,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "options": {
    "showHeader": true,
    "sortBy": [
     {
      "displayName": "fail",
      "desc": true
     }
    ]
   },
   "fieldConfig": {
    "defaults": {
     "decimals": 0
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "fail"
      },
      "properties": [
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-background"
        }
       },
       {
        "id": "thresholds",
        "value": {
         "mode": "absolute",
         "steps": [
          {
           "color": "transparent",
           "value": null
          },
          {
           "color": "red",
           "value": 1
          }
         ]
        }
       }
      ]
     }
    ]
   },
   "transformations": [
    {
     "id": "labelsToFields",
     "options": {
      "mode": "columns",
      "valueLabel": "result"
     }
    },
    {
     "id": "merge",
     "options": {}
    },
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true
      }
     }
    }
   ],
   "targets": [
    {
     "expr": "round(sum by (cluster, resource_namespace, policy_name, result) (increase(kyverno_image_validating_policy_results_total{cluster=~\"$cluster\", resource_namespace=~\"$namespace\", policy_name=~\"$policy\"}[$__range])))",
     "format": "time_series",
     "instant": true,
     "refId": "A"
    }
   ]
  },
  {
