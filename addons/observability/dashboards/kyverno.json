  {
   "id": 15,
   "type": "stat",
   "title": "Admission Throughput",
   "description": "Total admission requests processed per second.",
   "gridPos": {
    "x": 0,
    "y": 27,
    "w": 6,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
