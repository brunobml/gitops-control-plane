    {
      "id": 19,
      "type": "table",
      "title": "Kyverno pods",
      "description": "One row per running Kyverno pod (completed job pods are left out): ready containers, restarts in the last 24 h, memory as % of limit. Sorted by restarts.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 33,
        "w": 14,
        "h": 7
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Restarts (24 h)",
            "desc": true
          }
        ]
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Pod"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 330
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Cluster"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 120
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Ready"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "NOT READY",
                        "color": "red"
                      }
                    }
                  },
                  {
                    "type": "range",
                    "options": {
                      "from": 1,
                      "to": 99,
                      "result": {
                        "text": "ready",
                        "color": "green"
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Restarts (24 h)"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "transparent",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 1
                    },
                    {
                      "color": "red",
                      "value": 3
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Memory % of limit"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "min",
                "value": 0
              },
              {
                "id": "max",
                "value": 1
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "basic",
                  "valueDisplayMode": "text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 0.8
                    },
                    {
                      "color": "red",
                      "value": 0.9
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "instant": true,
          "range": false,
          "expr": "sum by (cluster, pod) (kube_pod_container_status_ready{namespace=\"kyverno\", cluster=~\"$cluster\"}) and on (cluster, pod) (kube_pod_status_phase{namespace=\"kyverno\", phase=\"Running\", cluster=~\"$cluster\"} == 1)"
        },
        {
          "refId": "B",
          "format": "table",
          "instant": true,
          "range": false,
          "expr": "round(sum by (cluster, pod) (increase(kube_pod_container_status_restarts_total{namespace=\"kyverno\", cluster=~\"$cluster\"}[24h]))) and on (cluster, pod) (kube_pod_status_phase{namespace=\"kyverno\", phase=\"Running\", cluster=~\"$cluster\"} == 1)"
        },
        {
          "refId": "C",
          "format": "table",
          "instant": true,
          "range": false,
          "expr": "sum by (cluster, pod) (process_resident_memory_bytes{job=\"kyverno\", cluster=~\"$cluster\"}) / on (cluster, pod) sum by (cluster, pod) (kube_pod_container_resource_limits{namespace=\"kyverno\", resource=\"memory\", cluster=~\"$cluster\"})"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "cluster": "Cluster",
              "pod": "Pod",
              "Value #A": "Ready",
              "Value #B": "Restarts (24 h)",
              "Value #C": "Memory % of limit"
            },
            "indexByName": {
              "cluster": 0,
              "pod": 1,
              "Value #A": 2,
              "Value #B": 3,
              "Value #C": 4
            }
          }
        }
      ]
