{
  "uid": "lab-kyverno-ops",
  "title": "Kyverno — Daily Operations",
  "description": "Day-to-day view of tenant admission control on the spokes: is enforcement working, what was blocked and why, is Kyverno healthy. Tenant panels exclude admission-probes, the smoke test's probe namespace.",
  "tags": [
    "gitops-lab",
    "kyverno",
    "security",
    "operations"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "1m",
  "schemaVersion": 39,
  "version": 3,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "links": [
    {
      "title": "Runbook: KyvernoDown",
      "type": "link",
      "url": "https://github.com/brunobml/gitops-control-plane/blob/main/docs/runbooks/host-reboot-and-cluster-lifecycle.md#alert-kyvernodown",
      "targetBlank": true,
      "icon": "doc"
    },
    {
      "title": "Logs & events",
      "type": "link",
      "url": "/d/lab-logs?var-namespace=kyverno",
      "icon": "dashboard"
    },
    {
      "title": "Kyverno (detail)",
      "type": "link",
      "url": "/d/lab-kyverno-test",
      "icon": "dashboard"
    },
    {
      "title": "Alerts",
      "type": "link",
      "url": "/alerting/list?search=Kyverno",
      "icon": "bolt"
    }
  ],
  "annotations": {
    "list": [
      {
        "name": "Kyverno restarts",
        "enable": true,
        "iconColor": "orange",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "expr": "changes(kube_pod_container_status_restarts_total{namespace=\"kyverno\", cluster=~\"$cluster\"}[2m]) > 0",
        "titleFormat": "Kyverno restart",
        "textFormat": "{{cluster}} {{pod}}",
        "step": "1m"
      },
      {
        "name": "Kyverno alerts",
        "enable": true,
        "iconColor": "red",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "expr": "ALERTS{alertname=~\"Kyverno.*\", alertstate=\"firing\"}",
        "titleFormat": "{{alertname}}",
        "textFormat": "{{cluster}}",
        "step": "1m"
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "cluster",
        "label": "Spoke",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(kyverno_admission_requests_total, cluster)",
        "query": {
          "query": "label_values(kyverno_admission_requests_total, cluster)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Right now: is admission control working?",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Admission controllers ready",
      "description": "Ready replicas of kyverno-admission-controller per spoke (2 desired). 0 = tenant pods cannot be created at all: the image webhook has failurePolicy Fail.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 5,
        "h": 5
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "auto",
        "orientation": "horizontal",
        "wideLayout": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "green",
                "value": 2
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "noValue": "NO DATA: agent down?",
          "links": [
            {
              "title": "Runbook: KyvernoDown",
              "url": "https://github.com/brunobml/gitops-control-plane/blob/main/docs/runbooks/host-reboot-and-cluster-lifecycle.md#alert-kyvernodown",
              "targetBlank": true
            }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (cluster) (kube_deployment_status_replicas_available{namespace=\"kyverno\", deployment=\"kyverno-admission-controller\", cluster=~\"$cluster\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "range": false,
          "legendFormat": "{{cluster}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Alerts firing",
      "description": "KyvernoDown (critical) and KyvernoSlowAdmission (warning) from the hub Prometheus. Click for the runbook.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 5,
        "y": 1,
        "w": 4,
        "h": 5
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "auto",
        "orientation": "horizontal",
        "wideLayout": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "None",
                  "color": "green"
                }
              }
            }
          ],
          "links": [
            {
              "title": "Runbook: KyvernoDown",
              "url": "https://github.com/brunobml/gitops-control-plane/blob/main/docs/runbooks/host-reboot-and-cluster-lifecycle.md#alert-kyvernodown",
              "targetBlank": true
            },
            {
              "title": "Alerting",
              "url": "/alerting/list?search=Kyverno"
            }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(ALERTS{alertname=~\"Kyverno.*\", alertstate=\"firing\"}) or vector(0)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Enforcement self-test (24 h)",
      "description": "Did Kyverno deny the smoke test's unsigned probe image in the last 24 h (make test, Gate 11b, namespace admission-probes)? 'Verified' proves enforcement end to end; 'Not verified' means no test ran, not that enforcement is off: run make test.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 9,
        "y": 1,
        "w": 5,
        "h": 5
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "auto",
        "orientation": "horizontal",
        "wideLayout": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "orange",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "Verified",
                  "color": "green"
                },
                "0": {
                  "text": "Not verified",
                  "color": "orange"
                }
              }
            }
          ],
          "noValue": "Not verified: run make test"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "clamp_max((sum by (cluster) (increase(kyverno_admission_requests_total{resource_namespace=\"admission-probes\", request_allowed=\"false\", cluster=~\"$cluster\"}[24h])) > 0) or (min by (cluster) (min_over_time(timestamp(kyverno_admission_requests_total{resource_namespace=\"admission-probes\", request_allowed=\"false\", cluster=~\"$cluster\"})[24h:1m])) > time() - 86340), 1) or sum by (cluster) (0 * kyverno_admission_requests_total{resource_namespace=\"admission-probes\", request_allowed=\"false\", cluster=~\"$cluster\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "range": false,
          "legendFormat": "{{cluster}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "p95 admission time (1 h)",
      "description": "p95 of Kyverno admission reviews over the last hour, all traffic. The image webhook times out at 30 s and the KyvernoSlowAdmission alert fires at 15 s. Signature checks call ghcr.io, so a few seconds are normal.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 14,
        "y": 1,
        "w": 5,
        "h": 5
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "auto",
        "orientation": "horizontal",
        "wideLayout": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 15
              },
              {
                "color": "red",
                "value": 25
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "noValue": "No admissions in 1 h"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(kyverno_admission_review_duration_seconds_bucket{cluster=~\"$cluster\"}[1h])))",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Tenant pods blocked (24 h)",
      "description": "Tenant pod creations Kyverno denied in the last 24 h (smoke-test probes excluded). Each one is a deployment that did not roll out: see 'Blocked tenant deployments' below.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 19,
        "y": 1,
        "w": 5,
        "h": 5
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "auto",
        "orientation": "horizontal",
        "wideLayout": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.5
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "range",
              "options": {
                "from": 0,
                "to": 0.5,
                "result": {
                  "text": "None",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(kyverno_admission_requests_total{request_allowed=\"false\", resource_namespace!=\"admission-probes\", cluster=~\"$cluster\"}[24h])) or vector(0)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 7,
      "type": "row",
      "title": "Tenants: what was admitted, what was blocked, and why",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Tenant pod admissions per hour",
      "description": "Tenant pod admission reviews per hour (smoke-test probes excluded). Red bars are blocked pods.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 9,
        "h": 8
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 2,
            "fillOpacity": 70,
            "gradientMode": "opacity",
            "showPoints": "auto",
            "pointSize": 6,
            "spanNulls": false,
            "axisSoftMin": 0,
            "thresholdsStyle": {
              "mode": "off"
            },
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "decimals": 0,
          "noValue": "No tenant admissions in range"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "admitted"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "blocked"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(kyverno_admission_requests_total{request_allowed=\"true\", resource_namespace!=\"admission-probes\", cluster=~\"$cluster\"}[1h]))",
          "legendFormat": "admitted",
          "interval": "1h"
        },
        {
          "refId": "B",
          "expr": "sum(increase(kyverno_admission_requests_total{request_allowed=\"false\", resource_namespace!=\"admission-probes\", cluster=~\"$cluster\"}[1h]))",
          "legendFormat": "blocked",
          "interval": "1h"
        }
      ],
      "interval": "1h"
    },
    {
      "id": 9,
      "type": "bargauge",
      "title": "Blocked pods by namespace (range)",
      "description": "Denied tenant pod creations per namespace in the selected range (probes excluded).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 9,
        "y": 7,
        "w": 6,
        "h": 8
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "namePlacement": "top",
        "valueMode": "color",
        "showUnfilled": true,
        "minVizHeight": 14,
        "maxVizHeight": 22,
        "text": {
          "titleSize": 13,
          "valueSize": 16
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "noValue": "None blocked",
          "color": {
            "mode": "fixed",
            "fixedColor": "red"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "instant": true,
          "range": false,
          "legendFormat": "{{resource_namespace}}",
          "expr": "sum by (cluster, resource_namespace) (increase(kyverno_admission_requests_total{request_allowed=\"false\", resource_namespace!=\"admission-probes\", cluster=~\"$cluster\"}[$__range])) > 0"
        }
      ]
    },
    {
      "id": 10,
      "type": "logs",
      "title": "Blocked tenant deployments (events; empty = none)",
      "description": "FailedCreate events in tenant namespaces: the controller (ReplicaSet, Job, ...) tried to create a pod and admission refused it. The message names the layer: Pod Security (violates PodSecurity), the registry allowlist (ValidatingAdmissionPolicy 'tenant-image-registry-allowlist') or Kyverno (tenant-images-signed).",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 15,
        "y": 7,
        "w": 9,
        "h": 8
      },
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{job=\"kubernetes-events\", namespace=~\"orders-.*|tenant-.*\", cluster=~\"$cluster\"} |~ \"reason=FailedCreate\"",
          "queryType": "range",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ]
    },
    {
      "id": 11,
      "type": "row",
      "title": "Supply chain: image signature checks",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Image signature checks per hour (tenants)",
      "description": "Evaluations of policy tenant-images-signed for tenant pods: pass = signed by the orders-processor CI workflow.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 10,
        "h": 8
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 2,
            "fillOpacity": 70,
            "gradientMode": "opacity",
            "showPoints": "auto",
            "pointSize": 6,
            "spanNulls": false,
            "axisSoftMin": 0,
            "thresholdsStyle": {
              "mode": "off"
            },
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "decimals": 0,
          "noValue": "No signature checks in range"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "pass"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "fail"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (result) (increase(kyverno_image_validating_policy_results_total{resource_namespace!=\"admission-probes\", cluster=~\"$cluster\"}[1h]))",
          "legendFormat": "{{result}}",
          "interval": "1h"
        }
      ],
      "interval": "1h"
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Signature check time p95 (policy execution)",
      "description": "p95 time Kyverno spends verifying signatures and SBOM attestations (calls to ghcr.io and the Sigstore transparency log). Dashed lines: KyvernoSlowAdmission at 15 s, webhook timeout at 30 s.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 10,
        "y": 16,
        "w": 7,
        "h": 8
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "gradientMode": "opacity",
            "showPoints": "always",
            "pointSize": 6,
            "spanNulls": false,
            "axisSoftMin": 0,
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "orange",
                "value": 15
              },
              {
                "color": "red",
                "value": 30
              }
            ]
          },
          "noValue": "No checks in range",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, cluster) (rate(kyverno_image_validating_policy_execution_duration_seconds_bucket{cluster=~\"$cluster\"}[30m])))",
          "legendFormat": "{{cluster}}"
        }
      ]
    },
    {
      "id": 14,
      "type": "logs",
      "title": "Signature failures (empty = none)",
      "description": "Kyverno's own reason for each failed check: missing signature, wrong signer identity, missing SBOM attestation. The smoke test's unsigned probe image is filtered out.",
      "datasource": {
        "type": "loki",
