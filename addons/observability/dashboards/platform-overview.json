{
 "uid": "lab-platform-overview",
 "title": "Platform overview",
 "tags": [
  "gitops-lab"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "refresh": "30s",
 "time": {
  "from": "now-1h",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Applications Synced/Healthy",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "count(argocd_app_info{sync_status=\"Synced\",health_status=\"Healthy\"})",
     "refId": "A"
    }
   ]
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Applications NOT Synced/Healthy",
   "gridPos": {
    "x": 6,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     }
    }
   },
   "targets": [
    {
     "expr": "count(argocd_app_info unless argocd_app_info{sync_status=\"Synced\",health_status=\"Healthy\"}) or vector(0)",
     "refId": "A"
    }
   ]
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Firing alerts",
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     }
    }
   },
   "targets": [
    {
     "expr": "count(ALERTS{alertstate=\"firing\"}) or vector(0)",
     "refId": "A"
    }
   ]
  },
  {
   "id": 4,
   "type": "table",
   "title": "Applications",
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 12,
    "h": 10
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "argocd_app_info",
     "format": "table",
     "instant": true,
     "refId": "A"
    }
   ],
   "transformations": [
    {
     "id": "organize",
     "options": {
      "includeByName": {
       "name": true,
       "project": true,
       "dest_server": true,
       "sync_status": true,
       "health_status": true
      }
     }
    }
   ]
  },
  {
   "id": 5,
   "type": "table",
   "title": "Cluster connections (1 = Successful)",
   "gridPos": {
    "x": 12,
    "y": 4,
    "w": 12,
    "h": 5
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "argocd_cluster_connection_status",
     "format": "table",
     "instant": true,
     "refId": "A"
    }
   ]
  },
  {
   "id": 6,
   "type": "alertlist",
   "title": "Firing alerts (Alertmanager)",
   "gridPos": {
    "x": 12,
    "y": 9,
    "w": 12,
    "h": 5
   },
   "options": {
    "alertInstanceLabelFilter": "",
    "datasource": "Alertmanager",
    "stateFilter": {
     "firing": true,
     "pending": true
    },
    "viewMode": "list",
    "groupMode": "default",
    "maxItems": 20
   }
  },
  {
   "id": 9,
   "type": "table",
   "title": "Team clusters",
   "gridPos": {
    "x": 0,
    "y": 14,
    "w": 24,
    "h": 6
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "time() - lab_team_cluster_info",
     "format": "table",
     "instant": true,
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "align": "auto"
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "Value"
      },
      "properties": [
       {
        "id": "displayName",
        "value": "Age"
       },
       {
        "id": "unit",
        "value": "s"
       }
      ]
     }
    ]
   },
   "transformations": [
    {
     "id": "organize",
     "options": {
      "includeByName": {
       "name": true,
       "team": true,
       "env": true,
       "cluster": true,
       "state": true,
       "readiness": true,
       "arn": true,
       "Value": true
      },
      "renameByName": {
       "name": "Cluster",
       "team": "Team",
       "env": "Env",
       "cluster": "Spoke",
       "state": "State",
       "readiness": "Readiness",
       "arn": "Cluster ARN",
       "Value": "Age"
      }
     }
    }
   ]
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Scrape targets up (by job, cluster)",
   "gridPos": {
    "x": 0,
    "y": 20,
    "w": 24,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "sum by (job, cluster) (up)",
     "legendFormat": "{{cluster}} {{job}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 8,
   "type": "logs",
   "title": "Recent warning events (all clusters) - details: Logs & events",
   "gridPos": {
    "x": 0,
    "y": 28,
    "w": 24,
    "h": 8
   },
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "options": {
    "showTime": true,
    "wrapLogMessage": true,
    "sortOrder": "Descending"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "{job=\"kubernetes-events\"} |= \"type=Warning\"",
     "maxLines": 50
    }
   ]
  }
 ],
 "links": [
  {
   "title": "Logs & events",
   "type": "link",
   "url": "/d/lab-logs",
   "icon": "doc",
   "targetBlank": false
  }
 ]
}